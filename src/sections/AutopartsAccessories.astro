---
import Card from '@/ui/Card.astro'
import TransmissionSuspension from '@/images/transmission-suspension.jpg'
import Accessories from '@/images/accessories.jpg'
import BrakeClutch from '@/images/brake-clutch.jpg'
import EngineParts from '@/images/engine-parts.jpg'

// Datos de prueba para simular varios alojamientos en diferentes destinos
const items = [
  {
    imageSrc: TransmissionSuspension,
    title: 'Transmisión y suspensión',
    description: 'Amortiguación, transmisión, tren delantero.',
    href: '/servicios',
  },
  {
    imageSrc: Accessories,
    title: 'Accesorios',
    description: 'Autopartes y accesorios.',
    href: '#',
  },
  {
    imageSrc: BrakeClutch,
    title: 'Freno y embrague',
    description: 'Embrague, disco de freno.',
    href: 'autopartes-accesorios',
  },
  {
    imageSrc: EngineParts,
    title: 'Partes del motor',
    description: 'Kits de distribución.',
    href: '#',
  },
]
---

<section class='py-12'>
  <div class='wrapper'>
    <h2
      class='text-base-content mb-8 text-center text-3xl font-light tracking-tight sm:text-4xl'
    >
      AUTOPARTES Y ACCESORIOS
    </h2>
    <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4'>
      <!-- grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 -->
      {items.map(item => <Card {...item} />)}
    </div>
  </div>
</section>
