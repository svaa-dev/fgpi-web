---

<footer
  class='bg-primary text-primary-content relative overflow-hidden pt-12 pb-8 brightness-90'
>
  <!-- Efecto decorativo sutil en el fondo del footer (Premium glow) -->
  <div
    class='pointer-events-none absolute inset-0 bg-linear-to-b via-black via-110% to-black/90'
  >
  </div>

  <div class='wrapper relative z-10'>
    <!-- SECCIÓN DE ENLACES PRINCIPALES (Grid Desktop / Listado Móvil) -->
    <div class='grid grid-cols-1 gap-8 lg:grid-cols-5 lg:gap-12'>
      {
        footerSections.map(section => {
          const isReclamaciones = section.title === 'Libro de Reclamaciones'
          return (
            /* En pantallas grandes renderizamos un contenedor normal, en móvil usamos un acordeón details interactivo */
            <div class='w-full'>
              {/* Vista Móvil - Acordeón nativo con details */}
              <details class='group border-b border-white/10 pb-4 lg:hidden'>
                <summary class='flex cursor-pointer list-none items-center justify-between py-2 text-base font-bold tracking-wide text-white select-none'>
                  {section.title}
                  <span class='text-white/60 transition-transform duration-300 group-open:rotate-180'>
                    <svg
                      class='size-4'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke='currentColor'
                    >
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        stroke-width='2.5'
                        d='M19 9l-7 7-7-7'
                      />
                    </svg>
                  </span>
                </summary>
                <ul class='mt-3 space-y-2.5 pl-1'>
                  {section.links.map(link => (
                    <li>
                      <a
                        href={link.href}
                        class='block py-1 text-sm text-white/80 transition-colors duration-200 hover:text-white active:text-white'
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                  {isReclamaciones && (
                    <li class='pt-3'>
                      <a
                        href='/legal/libro-de-reclamaciones'
                        class='inline-block transform text-white/80 transition-all duration-300 hover:scale-102 hover:text-white active:scale-98'
                        aria-label='Ir al Libro de Reclamaciones'
                      >
                        <ComplaintsBook class='w-36 text-current' />
                      </a>
                    </li>
                  )}
                </ul>
              </details>

              {/* Vista Desktop - Grid clásico y limpio sin colapsar */}
              <div class='hidden lg:block'>
                <a
                  href={section.href}
                  class='mb-5 block text-[15px] font-bold tracking-wide text-white uppercase opacity-95 transition-all duration-200 select-none hover:translate-x-1'
                >
                  {section.title}
                </a>
                <ul class='space-y-3'>
                  {section.links.map(link => (
                    <li>
                      <a
                        href={link.href}
                        class='inline-block transform text-sm text-white/70 transition-all duration-200 hover:translate-x-1 hover:text-white'
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
                {isReclamaciones && (
                  <div class='mt-6'>
                    <a
                      href='/legal/libro-de-reclamaciones'
                      class='inline-block transform text-white/70 transition-all duration-300 hover:scale-105 hover:text-white active:scale-98'
                      aria-label='Ir al Libro de Reclamaciones'
                    >
                      <ComplaintsBook class='w-40 text-current' />
                    </a>
                  </div>
                )}
              </div>
            </div>
          )
        })
      }
    </div>

    <!-- Divisor horizontal decorativo -->
    <hr class='my-8 border-white/10 lg:my-10' />

    <!-- SECCIÓN INFERIOR: Copyright & Redes Sociales -->
    <div class='flex flex-col items-center justify-center gap-6 sm:flex-row'>
      <!-- Copyright y atribución -->
      <div
        class='text-center text-xs text-white/60 select-none sm:text-left lg:text-sm'
      >
        <p>
          &copy; {currentYear} Todos los derechos reservados por <span
            class='font-semibold text-white'>{SEO.name}</span
          >.
        </p>
      </div>

      <!-- Iconos de Redes Sociales con efecto Premium de Hover y Foco -->
      <!-- <nav class="flex items-center gap-x-2.5" aria-label="Redes Sociales">
        {
          socialLinks.map(({ href, label, Icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center rounded-full transition-all duration-300 transform hover:scale-110 active:scale-95 focus:outline-none opacity-70"
              aria-label={label}
            >
              <Icon className="size-8" />
            </a>
          ))
        }
      </nav> -->
    </div>
  </div>
</footer>
