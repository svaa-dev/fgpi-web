---
import { Image } from 'astro:assets'
import Logo from '@/images/logo.png'
import Facebook from '@/icons/facebook'
import Instagram from '@/icons/instagram'
import Linkedin from '@/icons/linkedin'
import Tiktok from '@/icons/tiktok'
import MobileMenu from '@/components/ui/mobile-menu'
import { LINKS, SEO } from '@/constants'

// Enlaces de redes sociales mapeados con componentes de iconos e hipervínculos desde constantes globales
const socialLinks = [
  { href: SEO.socials.facebook.href, label: 'Facebook', icon: Facebook },
  { href: SEO.socials.instagram.href, label: 'Instagram', icon: Instagram },
  { href: SEO.socials.linkedin.href, label: 'LinkedIn', icon: Linkedin },
  { href: SEO.socials.tiktok.href, label: 'TikTok', icon: Tiktok },
]

const navLinks = [
  { href: LINKS.home.href, label: LINKS.home.label },
  { href: LINKS.services.href, label: LINKS.services.label },
  {
    href: LINKS.autoparts_accessories.href,
    label: LINKS.autoparts_accessories.label,
  },
  { href: LINKS.batteries.href, label: LINKS.batteries.label },
  { href: LINKS.company.href, label: LINKS.company.label },
  { href: LINKS.contact.href, label: LINKS.contact.label },
]
// const navLinks = [...Object.values(LINKS)]

const { pathname } = Astro.url
---

<!-- Encabezado pegajoso con desenfoque de fondo premium -->
<header
  class='border-base-200 bg-base-100 sticky top-0 z-50 border-b backdrop-blur-md transition-all duration-300'
>
  <div class='wrapper flex h-20 items-center justify-between'>
    <!-- Logotipo principal -->
    <a href='/' class='flex items-center transition-opacity hover:opacity-90'>
      <Image
        src={Logo}
        alt='Forte Glass Perú Import Logo'
        width={150}
        height={100}
        class='h-16 w-auto object-contain'
        priority
      />
    </a>

    <!-- Menú de navegación principal (Desktop) -->
    <nav
      class='hidden items-center gap-x-4 text-sm font-medium tracking-wide uppercase lg:flex'
    >
      {
        navLinks.map(link => {
          const isActive =
            link.href === '/'
              ? pathname === '/'
              : pathname.startsWith(link.href)
          return (
            <a
              href={link.href}
              class:list={[
                'relative py-2 text-sm font-semibold tracking-wide uppercase transition-colors duration-300',
                'after:bg-primary after:absolute after:bottom-0 after:left-0 after:h-0.5 after:transition-all after:duration-300',
                isActive
                  ? 'text-primary after:w-full'
                  : 'text-base-content/80 hover:text-primary after:w-0 hover:after:w-full',
              ]}
            >
              {link.label}
            </a>
          )
        })
      }
    </nav>

    <!-- Enlaces a Redes Sociales (Desktop/Tablet) -->
    <div class='hidden items-center gap-x-2.5 sm:flex'>
      {
        socialLinks.map(link => (
          <a
            href={link.href}
            target='_blank'
            rel='noopener noreferrer'
            class='flex items-center justify-center transition-all duration-300'
            aria-label={link.label}
          >
            <link.icon className='size-8 hover:scale-110 transition-transform' />
          </a>
        ))
      }
    </div>

    <!-- Botón del menú lateral (Móvil) -->
    <div
      class='text-base-content/80 flex items-center justify-center lg:hidden'
    >
      <MobileMenu client:load pathname={pathname} />
    </div>
  </div>
</header>
